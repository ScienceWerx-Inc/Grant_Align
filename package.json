{
  "name": "grant-align",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "db:studio": "prisma studio",
    "genkit:dev": "genkit start -- tsx --watch src/ai/dev.ts",
    "postinstall": "prisma generate",
    "smoke": "tsx --env-file-if-exists=.env scripts/smoke.ts",
    "demo": "tsx --env-file-if-exists=.env scripts/demo.ts"
  },
  "prisma": {
    "seed": "tsx --env-file-if-exists=.env prisma/seed.ts"
  },
  "dependencies": {
    "@genkit-ai/google-genai": "1.40.1",
    "@prisma/client": "^6.1.0",
    "cheerio": "^1.0.0",
    "genkit": "1.40.1",
    "next": "15.3.8",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "^6.1.0",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
