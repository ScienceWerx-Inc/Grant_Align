# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Prisma needs two URLs: DATABASE_URL for queries, DIRECT_URL for migrations.
# Migrations cannot run over a transaction-mode pooler, so they must bypass it.
#
# SUPABASE (deployed): Project Settings > Database > Connection string.
#   DATABASE_URL = the "Transaction pooler" URI, port 6543. Append
#     ?pgbouncer=true&connection_limit=1
#   pgbouncer=true stops Prisma using prepared statements, which a
#   transaction-mode pooler cannot hold across statements. connection_limit=1
#   keeps each serverless invocation to a single connection; without it Prisma
#   sizes its pool at num_cpus*2+1 per instance and exhausts the pooler.
#   DIRECT_URL = the "Direct connection" URI, port 5432.
#
# DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
#
# LOCAL: ./scripts/dev-db.sh start
DATABASE_URL="postgresql://postgres@127.0.0.1:5432/grantalign"
DIRECT_URL="postgresql://postgres@127.0.0.1:5432/grantalign"

# ---------------------------------------------------------------------------
# AI provider: "gemini" (default) or "mistral"
# ---------------------------------------------------------------------------
# Gemini is the better choice when quota is available: it can run Google Search
# as a tool, which is how donor research reaches Candid/GuideStar, Foundant and
# the Foundation Directory. Mistral cannot search, so on Mistral donor research
# uses only pages fetched directly from the funder's own site and labels the run
# accordingly.
AI_PROVIDER="gemini"

# Google AI Studio key. Note that a valid key on a project with no billing and
# no free-tier grant returns quota 0 on every model, in every region.
GEMINI_API_KEY=""

# Mistral La Plateforme key, used when AI_PROVIDER="mistral".
MISTRAL_API_KEY=""

# Mistral web search runs through the Agents API. The agent is found or created
# by name on first use; pin an existing one here to skip the lookup.
# MISTRAL_SEARCH_AGENT_ID=""
# MISTRAL_SEARCH_MODEL="mistral-medium-latest"

# Both default to gemini-2.5-flash, which is what free-tier keys can actually
# call. On a billed key, pointing the writing model at Pro measurably improves
# match scoring and the 1-pager.
# GENAI_MODEL="googleai/gemini-2.5-flash"
# GENAI_WRITING_MODEL="googleai/gemini-2.5-pro"

# ---------------------------------------------------------------------------
# Scheduled donor research
# ---------------------------------------------------------------------------
# Vercel Cron sends this as a bearer token. Without it the endpoint refuses to
# run in production, since an open refresh endpoint is a way to burn the quota.
CRON_SECRET=""
DONOR_REFRESH_BATCH="3"
DONOR_REFRESH_STALE_DAYS="14"
