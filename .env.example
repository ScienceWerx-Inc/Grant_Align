# ---------------------------------------------------------------------------
# Firebase — project grant-align (App Hosting backend grant-align, us-east4)
# ---------------------------------------------------------------------------
# Client SDK: Firebase console > Project settings > General > Your apps >
# Web app config. All NEXT_PUBLIC_FIREBASE_* are safe to expose.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="grant-align.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="grant-align"
NEXT_PUBLIC_FIREBASE_APP_ID=""

# Admin SDK: Project Settings > Service accounts > Generate new private key.
# Local dev: paste the values here. App Hosting: store them as SECRETS on the
# backend (Settings > Secrets) and reference them from apphosting.yaml.
FIREBASE_PROJECT_ID="grant-align"
FIREBASE_CLIENT_EMAIL=""
# Keep the literal \n newlines — the Admin SDK init restores them.
FIREBASE_PRIVATE_KEY=""

# ---------------------------------------------------------------------------
# Firebase Auth
# ---------------------------------------------------------------------------
# Enable Email/Password sign-in: console > Authentication > Sign-in method.
# No other auth env is needed: the browser signs in with the client SDK and
# the server verifies the __session cookie with the Admin SDK.

# ---------------------------------------------------------------------------
# AI provider: "gemini" (default) or "mistral"
# ---------------------------------------------------------------------------
# Gemini is the better choice when quota is available: it can run Google Search
# as a tool, which is how donor research reaches Candid/GuideStar, Foundant and
# the Foundation Directory. Mistral cannot search, so on Mistral donor research
# uses only pages fetched directly from the funder's own site and labels the run
# accordingly.
AI_PROVIDER="gemini"

# Google AI Studio key. Note that a valid key on a project with no billing and
# no free-tier grant returns quota 0 on every model, in every region.
GEMINI_API_KEY=""

# Mistral La Plateforme key, used when AI_PROVIDER="mistral".
MISTRAL_API_KEY=""

# Mistral web search runs through the Agents API. The agent is found or created
# by name on first use; pin an existing one here to skip the lookup.
# MISTRAL_SEARCH_AGENT_ID=""
# MISTRAL_SEARCH_MODEL="mistral-medium-latest"

# Both default to gemini-2.5-flash, which is what free-tier keys can actually
# call. On a billed key, pointing the writing model at Pro measurably improves
# match scoring and the 1-pager.
# GENAI_MODEL="googleai/gemini-2.5-flash"
# GENAI_WRITING_MODEL="googleai/gemini-2.5-pro"

# ---------------------------------------------------------------------------
# Scheduled donor research
# ---------------------------------------------------------------------------
# Firebase App Hosting has no built-in cron: schedule this with Cloud Scheduler
# (POST https://<backend-url>/api/cron/donor-refresh, Authorization: Bearer
# <CRON_SECRET>, e.g. `0 6 * * 1` America/New_York). Without the secret the
# endpoint refuses to run in production, since an open refresh endpoint is a
# way to burn the quota.
CRON_SECRET=""
DONOR_REFRESH_BATCH="3"
DONOR_REFRESH_STALE_DAYS="14"
